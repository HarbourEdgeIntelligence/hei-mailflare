{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hei-mailflare",
	"account_id": "a12823016aa16d0a8dd2678b258bd751",
	"main": "./worker.ts",
	"compatibility_date": "2026-05-20",
	"keep_vars": true,
	// No workers.dev URL; the app is served only on the custom domains below.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "mail.hei.dev", "custom_domain": true },
		{ "pattern": "mail.harbouredgeintelligence.com.au", "custom_domain": true },
		// Temporary hostname from the migration; remove once nothing links to it.
		{ "pattern": "mailflare.hei.dev", "custom_domain": true },
	],
	"vars": {
		// Must match the Worker name: Email Routing rules target this Worker.
		"CF_EMAIL_WORKER_NAME": "hei-mailflare",
		"APP_URL": "https://mail.hei.dev",
	},
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "none",
	},
	"images": {
		"binding": "IMAGES",
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hei-mailflare",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				"class_name": "RealtimeHub",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RealtimeHub",
			],
		},
	],
	"triggers": {
		"crons": ["0 2 * * *", "*/5 * * * *"],
	},
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60,
			},
		},
		{
			"name": "DEVICE_LOGIN_RATE_LIMIT",
			"namespace_id": "1003",
			"simple": { "limit": 10, "period": 60 },
		},
		{
			"name": "AGENT_RATE_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 120, "period": 60 },
		},
	],
	"observability": {
		"enabled": true,
		"traces": { "enabled": true },
	},
	"upload_source_maps": true,
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true,
		},
	],
	"ai": { "binding": "AI", "remote": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hei-mailflare",
			"database_id": "41e30cc6-3ba6-499a-ab3e-c82c33d4c2ce",
			"migrations_dir": "drizzle/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "hei-mailflare-raw",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "INBOUND_QUEUE",
				"queue": "hei-mailflare-inbound",
			},
			{
				"binding": "OUTBOUND_QUEUE",
				"queue": "hei-mailflare-outbound",
			},
			{
				"binding": "AGENT_QUEUE",
				"queue": "hei-mailflare-agent",
			},
		],
		"consumers": [
			{
				"queue": "hei-mailflare-inbound",
				"max_batch_size": 5,
				// New mail should reach the inbox at once; do not wait up to 5 s for a batch to fill.
				"max_batch_timeout": 1,
				"max_retries": 3,
			},
			{
				"queue": "hei-mailflare-outbound",
				"max_batch_size": 5,
				// Sends wait out the undo window already; do not also wait for a batch to fill.
				"max_batch_timeout": 1,
				"max_retries": 3,
			},
			{
				"queue": "hei-mailflare-agent",
				"max_batch_size": 1,
				"max_retries": 3,
			},
		],
	},
}
